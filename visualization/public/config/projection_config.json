      "opacity": 1.0
    },
    "overlays": [
      {
        "name": "buildings",
        "type": "geojson",
        "visible": true,
        "opacity": 0.8
      },
      {
        "name": "roads",
        "type": "geojson",
        "visible": true,
        "opacity": 0.7
      },
      {
        "name": "water",
        "type": "geojson",
        "visible": true,
        "opacity": 0.6
      }
    ]
  },
  "interaction": {
    "mode": "multi_user",
    "controllers": 3,
    "split_regions": true
  }
}
