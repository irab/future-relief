{
  "projection": {
    "name": "Wellington 3D Map",
    "region": "Wellington",
    "resolution": "1m",
    "coordinate_system": "EPSG:2193",
    "bounds": {
      "min_lon": 174.6,
      "max_lon": 175.0,
      "min_lat": -41.4,
      "max_lat": -41.1
    }
